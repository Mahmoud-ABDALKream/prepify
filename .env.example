# ─── Database Configuration ───────────────────────────
# For SQLite (default) - uses relative path that works in any environment:
DATABASE_URL="file:./db/custom.db"

# ─── Admin Configuration ──────────────────────────────
# Secret key for admin API access (change this in production!)
ADMIN_SECRET="change-me-to-a-strong-secret"

# ─── AI Integration (Optional) ────────────────────────
# API token for AI-powered analytics features
# Get your token from: https://z.ai/settings
AI_API_TOKEN=""

# ─── Analytics Configuration ──────────────────────────
# Enable/disable analytics tracking
ANALYTICS_ENABLED="true"

# ─── Application Settings ─────────────────────────────
# Environment: development | production | test
NODE_ENV="production"

# Port for the development server
PORT="3000"

# ─── Timezone ─────────────────────────────────────────
# Application timezone for all date/time operations
# Must match the target audience timezone
TZ="Africa/Cairo"
