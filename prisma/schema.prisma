generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  rating    Int
  subject   String?
  createdAt DateTime @default(now())
}
