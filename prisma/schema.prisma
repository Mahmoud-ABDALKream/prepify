generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  rating    Int
  subject   String?
  createdAt DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  subject         String
  quizId          String
  score           Float
  correctAnswers  Int
  wrongAnswers    Int
  totalQuestions  Int
  timeTaken       Int      // in seconds, 0 = no timer
  questionType    String   @default("multiple-choice") // multiple-choice, true-false, problem-solving, coding, practical
  attemptDate     DateTime @default(now())

  @@index([userId])
  @@index([subject])
  @@index([quizId])
  @@index([score])
  @@index([questionType])
  @@index([attemptDate])
  @@index([userId, subject])
  @@index([subject, attemptDate])
}

model ExamResult {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  subject       String
  examScore     Float    // 0-100
  passFail      String   @default("pass") // pass or fail
  gradeCategory String   @default("C")    // A, B, C, D, F
  examDate      DateTime @default(now())

  @@index([userId])
  @@index([subject])
  @@index([passFail])
  @@index([gradeCategory])
  @@index([examDate])
  @@index([userId, subject])
}

model QuestionResponse {
  id              String   @id @default(cuid())
  attemptId       String   // links to QuizAttempt.id
  userId          String
  userName        String
  subject         String
  questionId      Int      // the question number (e.g. 1-225 for IoT)
  questionType    String   // mcq, tf, fill, code, trace
  sectionTitle    String   // e.g. "Introduction to IoT"
  isCorrect       Boolean
  userAnswer      String?  // what the user answered
  correctAnswer   String?  // the correct answer
  timeTaken       Int      @default(0) // seconds spent on this question (0 if not tracked)
  difficulty      String   @default("medium") // easy, medium, hard
  bloomTaxonomy   String   @default("remember") // remember, understand, apply, analyze, evaluate, create
  responseDate    DateTime @default(now())

  @@index([attemptId])
  @@index([userId])
  @@index([subject])
  @@index([questionId])
  @@index([isCorrect])
  @@index([difficulty])
  @@index([bloomTaxonomy])
  @@index([questionType])
  @@index([subject, questionId])
  @@index([subject, isCorrect])
  @@index([subject, bloomTaxonomy])
  @@index([difficulty, isCorrect])
  @@index([bloomTaxonomy, isCorrect])
}
