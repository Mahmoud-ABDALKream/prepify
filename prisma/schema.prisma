generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  rating    Int
  subject   String?
  createdAt DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  subject         String
  quizId          String
  score           Float
  correctAnswers  Int
  wrongAnswers    Int
  totalQuestions  Int
  timeTaken       Int      // in seconds, 0 = no timer
  questionType    String   @default("multiple-choice") // multiple-choice, true-false, problem-solving, coding, practical
  attemptDate     DateTime @default(now())

  @@index([userId])
  @@index([subject])
  @@index([quizId])
  @@index([score])
  @@index([questionType])
  @@index([attemptDate])
  @@index([userId, subject])
  @@index([subject, attemptDate])
}

model ExamResult {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  subject       String
  examScore     Float    // 0-100
  passFail      String   @default("pass") // pass or fail
  gradeCategory String   @default("C")    // A, B, C, D, F
  examDate      DateTime @default(now())

  @@index([userId])
  @@index([subject])
  @@index([passFail])
  @@index([gradeCategory])
  @@index([examDate])
  @@index([userId, subject])
}
